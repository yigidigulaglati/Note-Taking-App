<!DOCTYPE html>

<html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <title></title>
        <meta name="description" content="">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="styles/styles.css">
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    </head>
    <body>
        <div class="header">
            <h1 class="app_title">Note App</h1>
            <button class="delete_all">Delete All Notes</button>
        </div>

        <div class="flashMsg"> 
        
        </div>

        <div class="note_form">
                

            <form class="my_form">

                <label for="title_field">Title</label>
                <textarea id="title_field" name="title" placeholder="Enter Title" required maxlength="20"></textarea>

                <label for="desc_field">Description</label>
                <textarea id="desc_field" name="description" placeholder="Enter Description" required></textarea>

                <button class="submit_btn">Submit</button>
            </form>
        </div>

        <div class="notes">
            
            <% for( let index = 0; index < notes.length; index++ ) { %> 
                <div class="note" id="<%- notes[index].id %>">
                    <div class="title"><%- notes[index].title %></div>
                    <div class="description"><%- notes[index].description %></div>

                    <button class="modifyBtn">Modify</button>
                    <button class="deleteBtn">Delete</button>
                </div>
            <% } %>
            
        </div>
        
            
        <script src="js/script.js"  defer></script>
    </body>
</html>